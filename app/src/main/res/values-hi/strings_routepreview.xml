    <string name="routepreview_no_route_title">कोई रास्ता नहीं मिला</string>
    <string name="routepreview_no_route_body">आपकी सेटिंग के साथ इन पड़ावों के बीच कोई रास्ता नहीं मिला। कोई पड़ाव, यात्रा का तरीका या बचने के विकल्प बदलकर देखें।</string>
    <string name="routepreview_permission_title">लोकेशन चाहिए</string>
    <string name="routepreview_permission_body">यह यात्रा \'मेरी लोकेशन\' से शुरू होती है। लोकेशन की अनुमति दें ताकि हम आपकी मौजूदा जगह से योजना बना सकें, या यात्रा बदलकर शुरुआती जगह चुनें।</string>
    <string name="routepreview_offline_title">रास्ता खोजने के लिए इंटरनेट चाहिए</string>
    <string name="routepreview_offline_body">यह रास्ता बनाने के लिए इंटरनेट से जुड़ें। आपकी सहेजी हुई यात्रा और डाउनलोड किए गए नक्शे अब भी उपलब्ध हैं।</string>
    <string name="routepreview_missing_title">यात्रा नहीं मिली</string>
    <string name="routepreview_missing_body">यह यात्रा हटा दी गई है, इसलिए दिखाने के लिए कुछ नहीं है।</string>
